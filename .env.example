# .env.example — copy to .env.local and fill in real values
# .env.local is gitignored — never commit credentials

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Bedrock
AWS_BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Region for Cost Explorer / CloudTrail / Athena / Glue.
# NOTE: AWS_REGION is a *reserved* Lambda environment variable and cannot be set
# on a function, so use FINOPS_AWS_REGION when the data plane is not in the same
# region as the function. Falls back to AWS_REGION, then us-east-1.
FINOPS_AWS_REGION=us-east-1

# Agent tuning
SPIKE_THRESHOLD_PCT=25.0
AGENT_MAX_ITERATIONS=8
# Services averaging less than this per day are ignored (noise floor).
MIN_BASELINE_USD=1.0
# A brand-new service (no baseline) is flagged if it costs more than this in a day.
NEW_SERVICE_USD=5.0

# Cost provider: COST_EXPLORER (CE, default, zero setup) or ATHENA_CUR (CUR)
# COST_PROVIDER=ATHENA_CUR

# --- CUR mode only ---
# ATHENA_DATABASE=your_db
# ATHENA_TABLE=your_table
# ATHENA_WORKGROUP=primary
# Optional — omit to use the workgroup's own output location.
# ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/
# ATHENA_TIMEOUT_SECONDS=60
